# ==============================================================================
# 1. PINECONE VECTOR DATABASE CONFIGURATION
# ==============================================================================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ustb-voice-kb
PINECONE_DIMENSION=384
PINECONE_METRIC=cosine

# ==============================================================================
# 2. HUGGING FACE API CONFIGURATION (FOR LLM & EMBEDDINGS)
# ==============================================================================
# Get your free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Hugging Face LLM for Voice Answers (Chat completion model):
# Recommended: meta-llama/Llama-3.1-8B-Instruct or Qwen/Qwen2.5-72B-Instruct
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ==============================================================================
# 3. EMBEDDING MODEL CONFIGURATION
# ==============================================================================
# Provider options:
#   - 'huggingface' : Calls Hugging Face Inference API using your HUGGINGFACE_API_KEY
#   - 'local'       : Runs SentenceTransformers locally (free, offline cache, 384 dim)
#   - 'openai'      : Uses OpenAI text-embedding-3-small (requires OPENAI_API_KEY, 1536 dim)
EMBEDDING_PROVIDER=huggingface

# Recommended 384-dimensional Hugging Face Embedding models:
#   - sentence-transformers/all-MiniLM-L6-v2 (fastest, standard)
#   - BAAI/bge-small-en-v1.5 (highest accuracy on retrieval benchmarks)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# (Optional: Only if using EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
